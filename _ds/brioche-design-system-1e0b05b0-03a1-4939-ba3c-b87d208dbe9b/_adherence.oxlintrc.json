{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/brioche-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Work Sans))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Work Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|muted|danger)$/]",
        "message": "<Badge> variant must be one of 'default' | 'muted' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|secondary-on-dark|dark-utility|pearl|hero)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'secondary-on-dark' | 'dark-utility' | 'pearl' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|onSearch|onCart|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: links, onSearch, onCart."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<OptionChip> doesn't accept that prop. Declared props: label, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|eyebrow|title|tagline|actions|media|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: variant, eyebrow, title, tagline, actions, media."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|parchment|dark|dark-2|dark-3)$/]",
        "message": "<ProductTile> variant must be one of 'light' | 'parchment' | 'dark' | 'dark-2' | 'dark-3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|price|cta|onCta|key|ref|className|style|children)$/]",
        "message": "<StickyBar> doesn't accept that prop. Declared props: label, price, cta, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|cta|onCta|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: category, cta, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:media|name|price|badge|cta|key|ref|className|style|children)$/]",
        "message": "<UtilityCard> doesn't accept that prop. Declared props: media, name, price, badge, cta."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
